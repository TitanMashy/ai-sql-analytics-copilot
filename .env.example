DATABASE_URL=postgresql+psycopg://app@postgres:5432/app
ANALYTICS_DATABASE_URL=postgresql+psycopg://analytics_readonly@postgres:5432/app
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_MODE=mock
LOG_LEVEL=INFO
MAX_RESULT_ROWS=1000
QUERY_TIMEOUT_SECONDS=10
MAX_QUERY_JOINS=5
MAX_QUERY_NESTING=3
MAX_REPAIR_RETRIES=3
