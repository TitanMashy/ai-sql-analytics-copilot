POSTGRES_PASSWORD=replace-with-an-owner-password
ANALYTICS_DATABASE_PASSWORD=replace-with-a-distinct-readonly-password
# Model provider, chosen explicitly: mock (offline, deterministic), gemini, or ollama (local).
# There is no fallback: if the selected provider is unavailable the request fails.
LLM_PROVIDER=mock
# Provider model id. Defaults to gemini-3.6-flash for gemini (model ids retire; set this explicitly); required for ollama.
LLM_MODEL=
GEMINI_API_KEY=
# Ollama runs on the host, not in Compose. Left unset: http://localhost:11434 when the backend runs
# directly, and http://host.docker.internal:11434 when it runs in Docker Compose.
# OLLAMA_BASE_URL=http://localhost:11434
# Extra attempts after a transient provider failure (the only retry in the model path).
LLM_MAX_RETRIES=1
APP_ENV=development
DEBUG=false
CORS_ALLOWED_ORIGINS=[]
LOG_LEVEL=INFO
MAX_RESULT_ROWS=1000
QUERY_TIMEOUT_SECONDS=10
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=5
MAX_QUERY_JOINS=5
MAX_QUERY_NESTING=3
MAX_REPAIR_RETRIES=3
ENABLE_RESULT_SUMMARY=true
LLM_TIMEOUT_SECONDS=30
MAX_QUESTION_LENGTH=2000
MAX_CONVERSATION_CONTEXT_CHARS=2000
MAX_REQUEST_BODY_BYTES=16384
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Request budget and rate limits -------------------------------------------------------
# One question (generation, repair attempts and the query) must finish within this budget. The
# frontend waits 30 seconds, so keep this below that.
REQUEST_DEADLINE_SECONDS=25
# Calls that reach the LLM (/generate and /ask) have their own, stricter limit per principal.
RATE_LIMIT_LLM_REQUESTS=20
# Trusted proxy addresses for X-Forwarded-For. In Compose only the frontend can reach the backend.
FORWARDED_ALLOW_IPS=*

# --- Authentication -----------------------------------------------------------------------
# jwt      signed bearer tokens (required when APP_ENV=production)
# disabled no credentials; everyone is a local development admin (rejected in production)
AUTH_MODE=disabled
# jwt mode: HS256 needs JWT_SECRET (32+ characters); RS256/ES256 need JWT_PUBLIC_KEY (PEM).
JWT_ALGORITHM=RS256
JWT_SECRET=
JWT_PUBLIC_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
# Tokens carry sub, exp, iss, aud, roles and customer_id. Role "analytics_admin" sees every
# customer; any other token is limited to its customer_id.

# --- Exposed surface ----------------------------------------------------------------------
# /api/v1/analytics/query and /validate run caller-written SQL. They are not mounted in
# production unless this is set to true, and the frontend proxy never forwards them.
ENABLE_DIRECT_SQL_ENDPOINTS=false
# /api/v1/metrics requires "Authorization: Bearer <token>" when set, and is disabled (404) in
# production when unset. The frontend proxy never forwards it.
METRICS_TOKEN=

# --- Durable state and shared limits ------------------------------------------------------
# memory = per process (fine for one instance, lost on restart); postgres = durable and shared by
# every replica (needs `alembic upgrade head`, which the Compose `migrate` service runs).
CONVERSATION_STORE=postgres
CONVERSATION_TTL_DAYS=30
# log | database | both. The audit trail holds identifiers and hashes, never question or SQL text.
AUDIT_SINK=both
AUDIT_RETENTION_DAYS=365
# Reject queries whose planner cost estimate exceeds this (PostgreSQL cost units). Empty disables.
QUERY_COST_LIMIT=1000000

# --- Observability ------------------------------------------------------------------------
APP_VERSION=0.0.0-dev

# --- Secrets as files ---------------------------------------------------------------------
# Any of DATABASE_URL, ANALYTICS_DATABASE_URL, GEMINI_API_KEY,
# JWT_SECRET, JWT_PUBLIC_KEY, METRICS_TOKEN can be supplied as NAME_FILE=/path instead
# of NAME=value (set one or the other, never both). Example:
#   GEMINI_API_KEY_FILE=/run/secrets/gemini_api_key

# --- Load testing only --------------------------------------------------------------------
# Simulated model latency for the mock provider (see docker-compose.loadtest.yml).
MOCK_LLM_LATENCY_MS=0
MOCK_LLM_JITTER_MS=0
